{
  "openapi": "3.0.0",
  "info": {
    "title": "Helpdesk API - UNINASSAU",
    "version": "1.0.0",
    "description": "API RESTful para gerenciamento e controle de chamados de TI com transição de status rigorosa."
  },
  "servers": [
    {
      "url": "https://helpdesk-api-uninassau.vercel.app/api",
      "description": "Servidor de Produção (Vercel)"
    }
  ],
  "paths": {
    "/tickets": {
      "get": {
        "summary": "Lista todos os chamados",
        "description": "Retorna uma lista de todos os tickets de suporte cadastrados no banco de dados, ordenados por ID.",
        "responses": {
          "200": {
            "description": "Lista de chamados retornada com sucesso."
          },
          "500": {
            "description": "Erro interno ao buscar chamados."
          }
        }
      },
      "post": {
        "summary": "Abre um novo chamado de suporte",
        "description": "Cria um ticket no sistema. Os campos título, descrição e setor são obrigatórios. Todo chamado nasce com o status 'Aberto'.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": { "type": "string", "example": "Impressora não liga" },
                  "descricao": { "type": "string", "example": "A impressora do setor de faturamento parou de funcionar do nada." },
                  "setor": { "type": "string", "example": "Faturamento" },
                  "prioridade": { "type": "string", "example": "Média" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Chamado aberto com sucesso."
          },
          "400": {
            "description": "Campos obrigatórios ausentes."
          },
          "500": {
            "description": "Erro interno ao criar o chamado."
          }
        }
      }
    },
    "/tickets/{id}/status": {
      "put": {
        "summary": "Atualiza o status de um chamado (Regra de Negócio)",
        "description": "Altera o status de um ticket respeitando o fluxo obrigatório do edital: Aberto -> Em Análise -> Resolvido. Chamados já resolvidos ficam imutáveis.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID numérico do chamado",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "example": "Em Análise" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status atualizado com sucesso."
          },
          "400": {
            "description": "Transição de status inválida ou chamado já resolvido."
          },
          "404": {
            "description": "Chamado não encontrado."
          },
          "500": {
            "description": "Erro interno ao atualizar o status."
          }
        }
      }
    },
    "/tickets/{id}": {
      "delete": {
        "summary": "Deleta um chamado do sistema",
        "description": "Remove permanentemente um chamado de suporte do banco de dados utilizando o ID fornecido na URL.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID numérico do chamado a ser excluído",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Chamado deletado com sucesso."
          },
          "404": {
            "description": "Chamado não encontrado para exclusão."
          },
          "500": {
            "description": "Erro ao deletar o chamado."
          }
        }
      }
    }
  }
}